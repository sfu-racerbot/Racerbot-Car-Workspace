<launch>
  <!-- Start after the simulator has generated its selected track. This launch never starts driving nodes. -->
  <arg name="map_file" description="The exact *_map.yaml used by the running Gym simulation" />
  <set_env name="ROS_DOMAIN_ID" value="79"/>
  <set_env name="ROS_LOCALHOST_ONLY" value="1"/>
  <set_env name="ROS_AUTOMATIC_DISCOVERY_RANGE" value="LOCALHOST"/>

  <node pkg="nav2_map_server" exec="map_server" name="sim_view_map_server">
    <param name="yaml_filename" value="$(var map_file)"/>
    <param name="topic_name" value="/sim/track_map"/>
    <param name="frame_id" value="sim_world"/>
  </node>
  <node pkg="nav2_lifecycle_manager" exec="lifecycle_manager" name="sim_view_map_lifecycle">
    <param name="autostart" value="true"/>
    <param name="node_names" value="['sim_view_map_server']"/>
  </node>
  <node pkg="foxglove_bridge" exec="foxglove_bridge" name="sim_view_bridge">
    <param name="address" value="127.0.0.1"/>
    <param name="port" value="8766"/>
    <param name="capabilities" value="['connectionGraph']"/>
    <param name="topic_whitelist" value="['^/(tf|tf_static|scan|odom|sim/status|sim/track_map|sim/(car2/)?ground_truth_pose|sim_only/ackermann_cmd)$']"/>
    <param name="client_topic_whitelist" value="['(?!)']"/>
    <param name="param_whitelist" value="['(?!)']"/>
    <param name="service_whitelist" value="['(?!)']"/>
    <param name="remote_access" value="false"/>
    <param name="sysinfo" value="false"/>
  </node>
</launch>
